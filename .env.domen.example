# Скопируйте в .env.domen (файл в .gitignore)
# Данные FTP: ISPmanager → FTP-пользователи → akvasnab.by

FTP_HOST=ftp.akvasnab.by
FTP_USER=ваш_логин_ftp
FTP_PASSWORD=ваш_пароль_ftp
# Корень сайта на сервере (часто /www/akvasnab.by или /)
FTP_REMOTE_PATH=/www/akvasnab.by/

# Пароль админки в сборке (обязательно смените!)
VITE_ADMIN_LOGIN=Андрей Емельянов
VITE_ADMIN_PASSWORD=надёжный_пароль
